# FactoryIQ Configuration Example
APP_NAME=FactoryIQ
ENV=development
HOST=0.0.0.0
PORT=8000

# Paths
DATA_DIR=data
MODELS_DIR=models
VECTOR_STORE_DIR=vector_store

# Vector DB & Embeddings
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
VECTOR_TOP_K=4

# LLM & GenAI API (Optional / Fallback mock generator enabled if empty)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL_NAME=gemini-2.5-flash
